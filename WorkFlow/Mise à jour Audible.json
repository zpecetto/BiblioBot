    {
      "parameters": {
        "jsCode": "const books = $input.all();\n\nlet totalOwnedSeconds = 0;\nlet totalListenedSeconds = 0;\n\nlet countPossedesTotal = 0;\nlet countPossedesEcoutes = 0;\nlet countSouhaits = 0;\n\n// Average only includes listened books with a valid duration.\nlet countEcoutesAvecDuree = 0;\n\n// Min and max durations of listened audiobooks.\nlet maxListenedSeconds = -1;\nlet minListenedSeconds = Infinity;\n\nlet titreMaxEcoute = \"Aucun\";\nlet titreMinEcoute = \"Aucun\";\n\nfunction normalizeText(value) {\n  return String(value || \"\")\n    .toLowerCase()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction parseDurationToSeconds(duration) {\n  const text = normalizeText(duration)\n    .replace(/heures?/g, \"h\")\n    .replace(/hours?/g, \"h\")\n    .replace(/minutes?/g, \"min\")\n    .replace(/\\s+et\\s+/g, \" \")\n    .replace(/\\s+and\\s+/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n\n  let hours = 0;\n  let minutes = 0;\n\n  const combinedMatch = text.match(/(\\d{1,3})\\s*h\\s*(\\d{1,2})\\s*min/);\n  const hourMatch = text.match(/(\\d{1,3})\\s*h/);\n  const minuteMatch = text.match(/(\\d{1,2})\\s*min/);\n\n  if (combinedMatch) {\n    hours = parseInt(combinedMatch[1], 10);\n    minutes = parseInt(combinedMatch[2], 10);\n  } else {\n    if (hourMatch) {\n      hours = parseInt(hourMatch[1], 10);\n    }\n\n    if (minuteMatch) {\n      minutes = parseInt(minuteMatch[1], 10);\n    }\n  }\n\n  if (Number.isNaN(hours)) hours = 0;\n  if (Number.isNaN(minutes)) minutes = 0;\n\n  // Preserve the existing guard against incorrectly parsed durations.\n  if (hours > 120 || minutes > 59) {\n    return 0;\n  }\n\n  return (hours * 3600) + (minutes * 60);\n}\n\nfunction formatSecondsToDuration(seconds) {\n  const safeSeconds = Number.isFinite(seconds) && seconds > 0 ? seconds : 0;\n\n  const totalMinutes = Math.round(safeSeconds / 60);\n  const hours = Math.floor(totalMinutes / 60);\n  const minutes = totalMinutes % 60;\n\n  return `${hours} h ${minutes} min`;\n}\n\nfunction normalizeStatus(status) {\n  return normalizeText(status);\n}\n\nfunction getBookTitle(book) {\n  return (\n    book.titre ||\n    book.title ||\n    book.nom ||\n    book.name ||\n    \"Titre inconnu\"\n  );\n}\n\nfor (const item of books) {\n  const book = item.json || {};\n\n  const status = normalizeStatus(book.statut);\n  const seconds = parseDurationToSeconds(book.duree_brute);\n  const titre = getBookTitle(book);\n\n  const isWishlist =\n    status === \"liste de souhait\" ||\n    status === \"liste d envie\" ||\n    status === \"liste d envies\";\n\n  const isOwned = status.startsWith(\"possede\");\n\n  const isListened =\n    status === \"possede et ecoute\" ||\n    status === \"possede et ecoutee\" ||\n    status === \"possede et lu\" ||\n    status === \"possede et termine\";\n\n  if (isWishlist) {\n    countSouhaits++;\n    continue;\n  }\n\n  if (isOwned) {\n    countPossedesTotal++;\n    totalOwnedSeconds += seconds;\n  }\n\n  if (isListened) {\n    countPossedesEcoutes++;\n    totalListenedSeconds += seconds;\n\n    if (seconds > 0) {\n      countEcoutesAvecDuree++;\n\n      if (seconds > maxListenedSeconds) {\n        maxListenedSeconds = seconds;\n        titreMaxEcoute = titre;\n      }\n\n      if (seconds < minListenedSeconds) {\n        minListenedSeconds = seconds;\n        titreMinEcoute = titre;\n      }\n    }\n  }\n}\n\nconst totalOwnedHours = Math.round(totalOwnedSeconds / 3600);\nconst totalListenedHours = Math.round(totalListenedSeconds / 3600);\n\nconst totalOwnedDurationFormatted =\n  formatSecondsToDuration(totalOwnedSeconds);\n\nconst totalListenedDurationFormatted =\n  formatSecondsToDuration(totalListenedSeconds);\n\nconst averageListenedSeconds =\n  countEcoutesAvecDuree > 0\n    ? totalListenedSeconds / countEcoutesAvecDuree\n    : 0;\n\nconst averageListenedDurationFormatted =\n  formatSecondsToDuration(averageListenedSeconds);\n\nconst maxEcouteFormatted =\n  maxListenedSeconds > 0\n    ? `${titreMaxEcoute} (${formatSecondsToDuration(maxListenedSeconds)})`\n    : \"Aucun\";\n\nconst minEcouteFormatted =\n  minListenedSeconds !== Infinity\n    ? `${titreMinEcoute} (${formatSecondsToDuration(minListenedSeconds)})`\n    : \"Aucun\";\n\nconst prixEstime = (countPossedesTotal * 9.95).toLocaleString(\"fr-FR\", {\n  minimumFractionDigits: 2,\n  maximumFractionDigits: 2\n});\n\nreturn [\n  {\n    json: {\n      Genre: \"Livre Audio\",\n\n      \"En possession (Total)\": countPossedesTotal,\n      \"En possession et Lu\": countPossedesEcoutes,\n      \"Liste de souhait\": countSouhaits,\n\n      // The existing Pages column stores total owned hours.\n      \"Pages\": totalOwnedHours,\n\n      // Overall durations.\n      \"Durée totale\": totalOwnedDurationFormatted,\n      \"Heures écoutées\": totalListenedHours,\n\n      // Listened duration in seconds.\n      \"Durée écoutée\": Math.round(totalListenedSeconds),\n\n      // Human-readable listened duration.\n      \"Durée écoutée formatée\": totalListenedDurationFormatted,\n\n      // Estimated price with French formatting.\n      \"Prix\": prixEstime,\n\n      // Min, max and average durations of listened audiobooks.\n      \"Max\": maxEcouteFormatted,\n      \"Min\": minEcouteFormatted,\n      \"Moyenne Audio\": averageListenedDurationFormatted,\n\n      // Keep compatibility with the existing Google Sheets column.\n      \"Moyenne Roman\": averageListenedDurationFormatted,\n\n      \"Max secondes\": maxListenedSeconds > 0 ? maxListenedSeconds : 0,\n      \"Min secondes\": minListenedSeconds !== Infinity ? minListenedSeconds : 0,\n      \"Moyenne secondes\": Math.round(averageListenedSeconds)\n    }\n  }\n];"
      },
