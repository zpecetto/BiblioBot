    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json || {};\n\nlet data = input;\n\n// Browserless peut renvoyer soit directement l'objet,\n// soit un objet avec data en string/object selon la config n8n.\nif (typeof data === \"string\") {\n  data = JSON.parse(data);\n}\n\nif (typeof data.data === \"string\") {\n  data = JSON.parse(data.data);\n} else if (data.data && typeof data.data === \"object\") {\n  data = data.data;\n}\n\nif (data.error) {\n  throw new Error(data.error);\n}\n\nconst books = Array.isArray(data.books) ? data.books : [];\n\nif (books.length === 0) {\n  const debug = {\n    statut_session: data.statut_session || null,\n    library_count: data.library_count || 0,\n    wishlist_count: data.wishlist_count || 0,\n    debug: data.debug || null,\n    keys_recues: Object.keys(data)\n  };\n\n  throw new Error(\n    \"Aucun livre Audible extrait. Debug: \" +\n    JSON.stringify(debug).slice(0, 4000)\n  );\n}\n\nfunction cleanText(value, fallback = \"\") {\n  return String(value || fallback)\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nconst unique = new Map();\n\nfor (const book of books) {\n  if (!book || !book.id_unique) continue;\n\n  const cleanBook = {\n    id_unique: cleanText(book.id_unique),\n    titre: cleanText(book.titre, \"Titre inconnu\"),\n    auteur: cleanText(book.auteur, \"Auteur inconnu\"),\n    duree_brute: cleanText(book.duree_brute, \"0 min\"),\n    statut: cleanText(book.statut, \"Non classé\"),\n    genre: \"Livre Audio\"\n  };\n\n  const key = `${cleanBook.id_unique}-${cleanBook.statut}`;\n  unique.set(key, cleanBook);\n}\n\nconst result = Array.from(unique.values()).map(book => ({\n  json: book\n}));\n\nif (result.length === 0) {\n  const debug = {\n    statut_session: data.statut_session || null,\n    library_count: data.library_count || 0,\n    wishlist_count: data.wishlist_count || 0,\n    debug: data.debug || null,\n    keys_recues: Object.keys(data)\n  };\n\n  throw new Error(\n    \"Aucun livre Audible valide après nettoyage. Debug: \" +\n    JSON.stringify(debug).slice(0, 4000)\n  );\n}\n\nreturn result;"
      },
